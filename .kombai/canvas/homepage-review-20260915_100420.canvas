text-4xl tracking-[-.03em]\" data-kid=\"1-4-6-1-1-2\" data-name=\"insights section title\">\n                        Ideas to carry forward\n                    </h2>\n                </div>\n                <a class=\"text-[11px] font-semibold uppercase tracking-[.16em] text-[#78716c] hover:text-[#a3413a]\" data-kid=\"1-4-6-1-2\" data-name=\"all insights link\" href=\"#all-insights\">\n                    All insights\n                    <span class=\"ml-2\" data-kid=\"1-4-6-1-2-1\" data-name=\"arrow icon\">\n                        →\n                    </span>\n                </a>\n            </div>\n            <div class=\"grid gap-0 border-y border-[#d8d4cf] md:grid-cols-2\" data-kid=\"1-4-6-2\" data-name=\"insights grid\">\n                <article class=\"border-b border-[#d8d4cf] py-8 md:border-r md:border-b-0 md:pr-12\" data-kid=\"1-4-6-2-1\" data-name=\"insight article\">\n                    <div class=\"text-[10px] font-semibold uppercase tracking-[.18em] text-[#a3413a]\" data-kid=\"1-4-6-2-1-1\" data-name=\"insight category\">\n                        BBC Business\n                    </div>\n                    <h3 class=\"editorial-serif mt-3 text-[31px] leading-tight\" data-kid=\"1-4-6-2-1-2\" data-name=\"insight title\">\n                        State pension likely to top £13,000 as UK wage growth slows\n                    </h3>\n                    <p class=\"mt-4 max-w-[450px] text-sm leading-relaxed text-[#78716c]\" data-kid=\"1-4-6-2-1-3\" data-name=\"insight summary\">\n                        A concise briefing on the policy, money and market stories that shape the decisions local leaders make.\n                    </p>\n                    <a class=\"mt-6 inline-block text-[10px] font-bold uppercase tracking-[.16em]\" data-kid=\"1-4-6-2-1-4\" data-name=\"insight link\" href=\"#insight-1\">\n                        Read the briefing\n                        <span class=\"ml-2 text-[#a3413a]\" data-kid=\"1-4-6-2-1-4-1\" data-name=\"arrow icon\">\n                            →\n                        </span>\n                    </a>\n                </article>\n                <article class=\"py-8 md:pl-12\" data-kid=\"1-4-6-2-2\" data-name=\"insight article\">\n                    <div class=\"text-[10px] font-semibold uppercase tracking-[.18em] text-[#a3413a]\" data-kid=\"1-4-6-2-2-1\" data-name=\"insight category\">\n                        BBC Business\n                    </div>\n                    <h3 class=\"editorial-serif mt-3 text-[31px] leading-tight\" data-kid=\"1-4-6-2-2-2\" data-name=\"insight title\">\n                        Trump says AI safety fears a ‘hoax’ as calls for safeguards grow\n                    </h3>\n                    <p class=\"mt-4 max-w-[450px] text-sm leading-relaxed text-[#78716c]\" data-kid=\"1-4-6-2-2-3\" data-name=\"insight summary\">\n                        The latest signal from the wider economy, translated for Yorkshire’s business community.\n                    </p>\n                    <a class=\"mt-6 inline-block text-[10px] font-bold uppercase tracking-[.16em]\" data-kid=\"1-4-6-2-2-4\" data-name=\"insight link\" href=\"#insight-2\">\n                        Read the briefing\n                        <span class=\"ml-2 text-[#a3413a]\" data-kid=\"1-4-6-2-2-4-1\" data-name=\"arrow icon\">\n                            →\n                        </span>\n                    </a>\n                </article>\n            </div>\n        </section>\n        <section class=\"bg-[#a3413a] text-white\" data-kid=\"1-4-7\" data-name=\"newsletter section\" id=\"join\">\n            <div class=\"mx-auto grid max-w-[1320px] gap-10 px-8 py-20 lg:grid-cols-[1fr_auto] lg:items-center\" data-kid=\"1-4-7-1\" data-name=\"newsletter content wrapper\">\n                <div data-kid=\"1-4-7-1-1\" data-name=\"newsletter intro\">\n                    <div class=\"mb-3 text-[10px] font-semibold uppercase tracking-[.22em] text-white/70\" data-kid=\"1-4-7-1-1-1\" data-name=\"newsletter label\">\n                        A Friday briefing for Yorkshire\n                    </div>\n                    <h2 class=\"editorial-serif text-5xl tracking-[-.04em]\" data-kid=\"1-4-7-1-1-2\" data-name=\"newsletter title\">\n                        Make room for a good idea.\n                    </h2>\n                    <p class=\"mt-4 max-w-[600px] text-sm leading-relaxed text-white/80\" data-kid=\"1-4-7-1-1-3\" data-name=\"newsletter description\">\n                        One useful email each Friday: the people to know, the stories to read and the opportunities worth your time.\n                    </p>\n                </div>\n                <form class=\"w-full max-w-[460px]\" data-kid=\"1-4-7-1-2\" data-name=\"newsletter form\">\n                    <label class=\"mb-2 block text-[10px] font-bold uppercase tracking-[.18em] text-white/75\" data-kid=\"1-4-7-1-2-1\" data-name=\"email label\" for=\"email\">\n                        Your email address\n                    </label>\n                    <div class=\"flex gap-2\" data-kid=\"1-4-7-1-2-2\" data-name=\"input field wrapper\">\n                        <input class=\"min-w-0 flex-1 border border-white/35 bg-transparent px-4 py-3.5 text-sm text-white placeholder:text-white/55 focus:border-white focus:outline-none\" data-kid=\"1-4-7-1-2-2-1\" data-name=\"email input field\" id=\"email\" placeholder=\"you@company.co.uk\" type=\"email\"/>\n                        <button class=\"shrink-0 bg-white px-5 py-3.5 text-[10px] font-bold uppercase tracking-[.15em] text-[#a3413a] hover:bg-[#f0ebe3]\" data-kid=\"1-4-7-1-2-2-2\" data-name=\"subscribe button\" type=\"button\">\n                            Subscribe\n                        </button>\n                    </div>\n                    <p class=\"mt-3 text-xs text-white/65\" data-kid=\"1-4-7-1-2-3\" data-name=\"spam warning text\">\n                        No spam. Unsubscribe any time.\n                    </p>\n                </form>\