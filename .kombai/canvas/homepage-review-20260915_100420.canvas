      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap');\n  .editorial-serif { font-family: 'Playfair Display', Georgia, serif; }\n  .hero-image { background-image: linear-gradient(90deg, rgba(15,14,12,.84) 0%, rgba(15,14,12,.52) 47%, rgba(15,14,12,.12) 100%), linear-gradient(0deg, rgba(15,14,12,.66) 0%, transparent 48%), url('https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&w=1800&q=82&fit=crop'); background-size: cover; background-position: center 28%; }\n  .rule-fade { background: linear-gradient(90deg, #a3413a, rgba(163,65,58,.2), transparent); }\n  .grain { background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.035'/%3E%3C/svg%3E\"); pointer-events: none; }\n  .paper-shadow { box-shadow: 0 16px 48px rgba(28,25,23,.08); }\n</style>\n<div class=\"min-h-screen bg-[#fafaf9] text-[#1c1917] font-sans selection:bg-[#a3413a]/20\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"grain fixed inset-0 z-0\" data-kid=\"1-1\" data-name=\"grain effect overlay\">\n    </div>\n    <header class=\"relative z-10 border-b border-[#e7e5e4] bg-[#fafaf9]/95\" data-kid=\"1-2\" data-name=\"header navigation container\">\n        <div class=\"mx-auto flex max-w-[1320px] items-center justify-between px-8 py-5\" data-kid=\"1-2-1\" data-name=\"header layout wrapper\">\n            <a aria-label=\"Yorkshire BusinessWoman home\" class=\"flex items-center gap-3\" data-kid=\"1-2-1-1\" data-name=\"home link\" href=\"#top\">\n                <div class=\"flex h-9 w-9 items-center justify-center border border-[#a3413a] text-[#a3413a] editorial-serif text-lg\" data-kid=\"1-2-1-1-1\" data-name=\"YB logo icon\">\n                    YB\n                </div>\n                <div data-kid=\"1-2-1-1-2\" data-name=\"brand name and tagline container\">\n                    <div class=\"editorial-serif text-[22px] leading-none tracking-[-.03em]\" data-kid=\"1-2-1-1-2-1\" data-name=\"brand name text\">\n                        Yorkshire\n                        <span class=\"italic\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"italic brand name word\">\n                            BusinessWoman\n                        </span>\n                    </div>\n                    <div class=\"mt-1 text-[9px] font-semibold uppercase tracking-[.28em] text-[#78716c]\" data-kid=\"1-2-1-1-2-2\" data-name=\"tagline text\">\n                        Magazine · Community · Yorkshire\n                    </div>\n                </div>\n            </a>\n            <nav aria-label=\"Primary navigation\" class=\"hidden items-center gap-9 lg:flex\" data-kid=\"1-2-1-2\" data-name=\"primary navigation links\">\n                <a class=\"text-[11px] font-semibold uppercase tracking-[.17em] text-[#1c1917] hover:text-[#a3413a]\" data-kid=\"1-2-1-2-1\" data-name=\"navigation news link\" href=\"#stories\">\n                    News\n                </a>\n                <a class=\"text-[11px] font-semibold uppercase tracking-[.17em] text-[#1c1917] hover:text-[#a3413a]\" data-kid=\"1-2-1-2-2\" data-name=\"navigation new edition link\" href=\"#edition\">\n                    New Edition\n                </a>\n                <a class=\"text-[11px] font-semibold uppercase tracking-[.17em] text-[#1c1917] hover:text-[#a3413a]\" data-kid=\"1-2-1-2-3\" data-name=\"navigation events link\" href=\"#events\">\n                    Events\n                </a>\n                <a class=\"text-[11px] font-semibold uppercase tracking-[.17em] text-[#1c1917] hover:text-[#a3413a]\" data-kid=\"1-2-1-2-4\" data-name=\"navigation members link\" href=\"#topics\">\n                    Members\n                </a>\n                <a class=\"text-[11px] font-semibold uppercase tracking-[.17em] text-[#1c1917] hover:text-[#a3413a]\" data-kid=\"1-2-1-2-5\" data-name=\"navigation about link\" href=\"#about\">\n                    About\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-4\" data-kid=\"1-2-1-3\" data-name=\"authentication buttons container\">\n                <a class=\"hidden text-[10px] font-bold uppercase tracking-[.18em] text-[#78716c] hover:text-[#a3413a] sm:block\" data-kid=\"1-2-1-3-1\" data-name=\"sign in link\" href=\"#sign-in\">\n                    Sign in\n                </a>\n                <a class=\"bg-[#a3413a] px-5 py-3 text-[10px] font-bold uppercase tracking-[.18em] text-white hover:bg-[#883832]\" data-kid=\"1-2-1-3-2\" data-name=\"join now link\" href=\"#join\">\n                    Join now\n                </a>\n            </div>\n        </div>\n    </header>\n    <div class=\"relative z-10 border-b border-[#2b2926] bg-[#211f1c] text-[#f5efe8]\" data-kid=\"1-3\" data-name=\"in-focus announcement bar\">\n        <div class=\"mx-auto flex max-w-[1320px] items-center justify-between gap-5 px-8 py-2.5\" data-kid=\"1-3-1\" data-name=\"in-focus content wrapper\">\n            <div class=\"flex min-w-0 items-center gap-4 text-[10px] font-semibold uppercase tracking-[.14em]\" data-kid=\"1-3-1-1\" data-name=\"announcement label container\">\n                <span class=\"shrink-0 text-[#c9956a]\" data-kid=\"1-3-1-1-1\" data-name=\"in focus label\">\n                    In focus\n                </span>\n                <span class=\"truncate text-white/75\" data-kid=\"1-3-1-1-2\" data-name=\"announcement headline\">\n                    Yorkshire businesses, leaders and the people making a difference\n                </span>\n            </div>\n            <a class=\"shrink-0 text-[10px] font-semibold uppercase tracking-[.14em] text-white/55 hover:text-white\" data-kid=\"1-3-1-2\" data-name=\"read the latest