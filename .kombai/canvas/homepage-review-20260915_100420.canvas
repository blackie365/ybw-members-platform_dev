      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');\n  .ybw-page { font-family: 'Inter', sans-serif; }\n  .ybw-serif { font-family: 'Playfair Display', Georgia, serif; }\n  .ybw-kicker { letter-spacing: .16em; text-transform: uppercase; font-size: 10px; font-weight: 700; }\n  .ybw-rule { border-color: rgba(28,25,23,.14); }\n  .story-option[aria-pressed='true'] { background: #f0ebe3; border-color: #a3413a; }\n  .story-option[aria-pressed='true'] .story-index { color: #a3413a; }\n  .story-option[aria-pressed='true'] .story-arrow { opacity: 1; transform: translateX(0); }\n  .story-arrow { opacity: 0; transform: translateX(-5px); transition: opacity .2s ease, transform .2s ease; }\n  .story-option:hover .story-arrow { opacity: 1; transform: translateX(0); }\n  .editorial-link:hover .link-arrow { transform: translateX(4px); }\n  .link-arrow { transition: transform .2s ease; }\n</style>\n<div class=\"ybw-page min-h-screen bg-[#fafaf9] text-[#1c1917]\" data-kid=\"1\">\n    <header class=\"border-b border-stone-900/15 bg-[#fafaf9]\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex max-w-[1280px] items-center justify-between px-8 py-6\" data-kid=\"1-1-1\">\n            <a class=\"flex items-baseline gap-2 no-underline\" data-kid=\"1-1-1-1\" href=\"#top\">\n                <span class=\"ybw-serif text-[19px] leading-none text-[#1c1917]\" data-kid=\"1-1-1-1-1\">\n                    Yorkshire\n                </span>\n                <span class=\"ybw-serif text-[24px] font-semibold leading-none text-[#1c1917]\" data-kid=\"1-1-1-1-2\">\n                    BusinessWoman\n                </span>\n            </a>\n            <nav aria-label=\"Primary navigation\" class=\"hidden items-center gap-8 text-[10px] font-semibold uppercase tracking-[.18em] text-stone-700 lg:flex\" data-kid=\"1-1-1-2\">\n                <a class=\"hover:text-[#a3413a]\" data-kid=\"1-1-1-2-1\" href=\"#top\">\n                    Home\n                </a>\n                <a class=\"hover:text-[#a3413a]\" data-kid=\"1-1-1-2-2\" href=\"#stories\">\n                    News\n                </a>\n                <a class=\"hover:text-[#a3413a]\" data-kid=\"1-1-1-2-3\" href=\"#events\">\n                    Events\n                </a>\n                <a class=\"hover:text-[#a3413a]\" data-kid=\"1-1-1-2-4\" href=\"#topics\">\n                    Topics\n                </a>\n                <a class=\"hover:text-[#a3413a]\" data-kid=\"1-1-1-2-5\" href=\"#community\">\n                    Members\n                </a>\n                <a class=\"hover:text-[#a3413a]\" data-kid=\"1-1-1-2-6\" href=\"#about\">\n                    About\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-4\" data-kid=\"1-1-1-3\">\n                <a class=\"hidden text-[10px] font-semibold uppercase tracking-[.16em] text-stone-700 hover:text-[#a3413a] sm:inline\" data-kid=\"1-1-1-3-1\" href=\"#newsletter\">\n                    Sign in\n                </a>\n                <a class=\"bg-[#a3413a] px-5 py-3 text-[10px] font-bold uppercase tracking-[.16em] text-white hover:bg-[#873730]\" data-kid=\"1-1-1-3-2\" href=\"#newsletter\">\n                    Join now\n                </a>\n            </div>\n        </div>\n    </header>\n    <div class=\"border-b border-stone-900/15 bg-[#26211f] text-[#fafaf9]\" data-kid=\"1-2\">\n        <div class=\"mx-auto flex max-w-[1280px] items-center gap-8 overflow-hidden px-8 py-2.5 text-[10px] font-medium uppercase tracking-[.13em] text-stone-300\" data-kid=\"1-2-1\">\n            <span class=\"shrink-0 text-[#c9956a]\" data-kid=\"1-2-1-1\">\n                This week\n            </span>\n            <span class=\"truncate\" data-kid=\"1-2-1-2\">\n                Zebra Print Group celebrates 20 years in business\n            </span>\n            <span class=\"text-[#a3413a]\" data-kid=\"1-2-1-3\">\n                •\n            </span>\n            <span class=\"truncate\" data-kid=\"1-2-1-4\">\n                Yorkshire law firm achieves six years of growth\n            </span>\n            <span class=\"text-[#a3413a]\" data-kid=\"1-2-1-5\">\n                •\n            </span>\n            <span class=\"truncate\" data-kid=\"1-2-1-6\">\n                The Dance Studio named a favourite local business\n            </span>\n        </div>\n    </div>\n    <main data-kid=\"1-3\" id=\"top\">\n        <section class=\"mx-auto max-w-[1280px] px-8 pb-16 pt-12 lg:pb-20 lg:pt-16\" data-kid=\"1-3-1\">\n            <div class=\"grid items-stretch gap-10 lg:grid-cols-[1.45fr_.85fr]\" data-kid=\"1-3-1-1\">\n                <article class=\"group relative overflow-hidden bg-[#1c1917] text-white\" data-kid=\"1-3-1-1-1\">\n                    <div class=\"relative h-full min-h-[560px] overflow-hidden\" data-kid=\"1-3-1-1-1-1\">\n                        <img alt=\"Businesswoman smiling in a bright office\" class=\"absolute inset-0 h-full w-full object-cover opacity-90\" data-kid=\"1-3-1-1-1-1-1\" data-name=\"hero image\" decoding=\"async\" id=\"hero-image\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&w=1400&q=82&fit=crop\"/>\n                        <div class=\"absolute inset-0 bg-gradient-to-r from-black/75 via-black/35 to-black/10\" data-kid=\"1-3-1-1-1-1-2\">\n                        </div>\n                        <div class=\"absolute inset-x-0 bottom-0 p-10 lg:p-14\" data-kid=\"1-3-1-1-1-1-3\">\n                            <div class=\"mb-5 flex items-center gap-3\" data-kid=\"1-3-1-1-1-1-3-1\">\n                                <span class=\"bg-[#a3413a] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[.18em] text-white\" data-kid=\"1-3-1-1-1-1-3-1-1\">\n                                    Business\n                                </span>\n                                <span class=\"text-[11px] text-white/70\" data-kid=\"1-3-1-1-1-1-3-1-2\">\n                                    2 min read\n                                </span>\n                            </div>\n                            <h1 class=\"ybw-serif max-w-2xl text-5xl font-medium leading-[1.04] tracking-[-.02em] lg:text-[4.6rem]\" data-kid=\"1-3-1-1-1-1-3-2\" data-name=\"hero headline text\" id=\"hero-title\">\n                                Zebra Print Group celebrates 20 years in business\n                            </h1>\n                            <p class=\"mt-6 max-w-xl text-[15px] leading-7 text-white/75\" data-kid=\"1-3-1-1-1-1-3-3\" data-name=\"hero excerpt text\" id=\"hero-excerpt\">\n                                Leeds-based Zebra Print Group is celebrating 20 years in business, marking two decades since the family-run print company was founded.\n                            </p>\n                            <div class=\"mt-8 flex items-center gap-5\" data-kid=\"1-3-1-1-1-1-3-4\">\n                                <a class=\"inline-flex items-center gap-3 bg-white px-6 py-3.5 text-[10px] font-bold uppercase tracking-[.16em] text-[#1c1917] hover:bg-[#f0ebe3]\" data-kid=\"1-3-1-1-1-1-3-4-1\" href=\"#stories\" id=\"hero-link\">\n                                    Read article\n                                    <span aria-hidden=\"true\" data-kid=\"1-3-1-1-1-1-3-4-1-1\">\n                                        →\n                                    </span>\n                                </a>\n                                <a class=\"inline-flex items-center gap-2 border border-white/50 px-5 py-3.5 text-[10px] font-bold uppercase tracking-[.16em] text-white hover:border-white\" data-kid=\"1-3-1-1-1-1-3-4-2\" href=\"#edition\">\n                                    New edition\n                                    <span aria-hidden=\"true\" data-kid=\"1-3-1-1-1-1-3-4-2-1\">\n                                        ↗\n                                    </span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </article>\n                <aside class=\"flex flex-col border border-stone-900/15 bg-white\" data-kid=\"1-3-1-1-2\">\n                    <div class=\"border-b border-stone-900/15 px-7 py-6\" data-kid=\"1-3-1-1-2-1\">\n                        <div class=\"flex items-end justify-between gap-4\" data-kid=\"1-3-1-1-2-1-1\">\n                            <div data-kid=\"1-3-1-1-2-1-1-1\">\n                                <p class=\"ybw-kicker text-[#a3413a]\" data-kid=\"1-3-1-1-2-1-1-1-1\">\n                                    The front page\n                                </p>\n                                <h2 class=\"ybw-serif mt-2 text-3xl leading-tight\" data-kid=\"1-3-1-1-2-1-1-1-2\">\n                                    Choose a story\n                                </h2>\n                            </div>\n                            <span class=\"text-[11px] text-stone-500\" data-kid=\"1-3-1-1-2-1-1-2\">\n                                01 / 03\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"flex-1 divide-y divide-stone-900/10\" data-kid=\"1-3-1-1-2-2\">\n                        <button aria-pressed=\"true\" class=\"story-option flex w-full gap-4 border-l-2 border-transparent px-7 py-7 text-left\" data-kid=\"1-3-1-1-2-2-1\" data-story=\"0\" type=\"button\">\n                            <span class=\"story-index ybw-serif mt-0.5 text-2xl text-stone-400\" data-kid=\"1-3-1-1-2-2-1-1\">\n                                01\n                            </span>\n                            <span class=\"min-w-0 flex-1\" data-kid=\"1-3-1-1-2-2-1-2\">\n                                <span class=\"ybw-kicker text-[#a3413a]\" data-kid=\"1-3-1-1-2-2-1-2-1\">\n                                    Business · 2 min\n                                </span>\n                                <span class=\"mt-2 block font-serif text-xl leading-snug text-[#1c1917]\" data-kid=\"1-3-1-1-2-2-1-2-2\">\n                                    Zebra Print Group celebrates 20 years in business\n                                </span>\n                                <span class=\"mt-3 block text-sm leading-6 text-stone-500\" data-kid=\"1-3-1-1-2-2-1-2-3\">\n                                    A family-run Leeds business marks a milestone with a new chapter.\n                                </span>\n                            </span>\n                            <span class=\"story-arrow mt-1 text-lg text-[#a3413a]\" data-kid=\"1-3-1-1-2-2-1-3\">\n                                →\n                            </span>\n                        </button>\n                        <button aria-pressed=\"false\" class=\"story-option flex w-full gap-4 border-l-2 border-transparent px-7 py-7 text-left\" data-kid=\"1-3-1-1-2-2-2\" data-story=\"1\" type=\"button\">\n                            <span class=\"story-index ybw-serif mt-0.5 text-2xl text-stone-400\" data-kid=\"1-3-1-1-2-2-2-1\">\n                                02\n                            </span>\n                            <span class=\"min-w-0 flex-1\" data-kid=\"1-3-1-1-2-2-2-2\">\n                                <span class=\"ybw-kicker text-stone-500\" data-kid=\"1-3-1-1-2-2-2-2-1\">\n                                    Business · 3 min\n                                </span>\n                                <span class=\"mt-2 block font-serif text-xl leading-snug text-[#1c1917]\" data-kid=\"1-3-1-1-2-2-2-2-2\">\n                                    Yorkshire law firm achieves six years of growth\n                                </span>\n                                <span class=\"mt-3 block text-sm leading-6 text-stone-500\" data-kid=\"1-3-1-1-2-2-2-2-3\">\n                                    A closer look at the people and decisions behind a regional success story.\n                                </span>\n                            </span>\n                            <span class=\"story-arrow mt-1 text-lg text-[#a3413a]\" data-kid=\"1-3-1-1-2-2-2-3\">\n                                →\n                            </span>\n                        </button>\n                        <button aria-pressed=\"false\" class=\"story-option flex w-full gap-4 border-l-2 border-transparent px-7 py-7 text-left\" data-kid=\"1-3-1-1-2-2-3\" data-story=\"2\" type=\"button\">\n                            <span class=\"story-index ybw-serif mt-0.5 text-2xl text-stone-400\" data-kid=\"1-3-1-1-2-2-3-1\">\n                                03\n                            </span>\n                            <span class=\"min-w-0 flex-1\" data-kid=\"1-3-1-1-2-2-3-2\">\n                                <span class=\"ybw-kicker text-stone-500\" data-kid=\"1-3-1-1-2-2-3-2-1\">\n                                    Community · 4 min\n                                </span>\n                                <span class=\"mt-2 block font-serif text-xl leading-snug text-[#1c1917]\" data-kid=\"1-3-1-1-2-2-3-2-2\">\n                                    The Dance Studio named a favourite local business\n                                </span>\n                                <span class=\"mt-3 block text-sm leading-6 text-stone-500\" data-kid=\"1-3-1-1-2-2-3-2-3\">\n                                    How one Leeds studio built a community around movement and confidence.\n                                </span>\n                            </span>\n                            <span class=\"story-arrow mt-1 text-lg text-[#a3413a]\" data-kid=\"1-3-1-1-2-2-3-3\">\n                                →\n                            </span>\n                        </button>\n                    </div>\n                    <div class=\"border-t border-stone-900/15 px-7 py-6\" data-kid=\"1-3-1-1-2-3\">\n                        <a class=\"editorial-link inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-[.16em] text-stone-700 hover:text-[#a3413a]\" data-kid=\"1-3-1-1-2-3-1\" href=\"#stories\">\n                            Browse all stories\n                            <span class=\"link-arrow\" data-kid=\"1-3-1-1-2-3-1-1\">\n                                →\n                            </span>\n                        </a>\n                    </div>\n                </aside>\n            </div>\n            <div class=\"mt-8 flex items-center justify-between border-t border-stone-900/15 pt-5 text-[11px] text-stone-500\" data-kid=\"1-3-1-2\">\n                <span data-kid=\"1-3-1-2-1\">\n                    Fresh perspectives on business, leadership, and life in Yorkshire.\n                </span>\n                <span data-kid=\"1-3-1-2-2\">\n                    15 September 2026\n                </span>\n            </div>\n        </section>\n        <section class=\"border-y border-stone-900/15 bg-white\" data-kid=\"1-3-2\" id=\"stories\">\n            <div class=\"mx-auto max-w-[1280px] px-8 py-16 lg:py-20\" data-kid=\"1-3-2-1\">\n                <div class=\"mb-10 flex items-end justify-between gap-8\" data-kid=\"1-3-2-1-1\">\n                    <div data-kid=\"1-3-2-1-1-1\">\n                        <p class=\"ybw-kicker text-[#a3413a]\" data-kid=\"1-3-2-1-1-1-1\">\n                            From the magazine\n                        </p>\n                        <h2 class=\"ybw-serif mt-2 text-4xl\" data-kid=\"1-3-2-1-1-1-2\">\n                            Latest stories\n                        </h2>\n                    </div>\n                    <a class=\"editorial-link inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-[.16em] text-stone-600 hover:text-[#a3413a]\" data-kid=\"1-3-2-1-1-2\" href=\"#topics\">\n                        Explore the newsroom\n                        <span class=\"link-arrow\" data-kid=\"1-3-2-1-1-2-1\">\n                            →\n                        </span>\n                    </a>\n                </div>\n                <div class=\"grid gap-12 lg:grid-cols-[1.15fr_.85fr]\" data-kid=\"1-3-2-1-2\">\n                    <article class=\"grid gap-7 md:grid-cols-[1.05fr_.95fr] md:items-center\" data-kid=\"1-3-2-1-2-1\">\n                        <img alt=\"Bright local creative workspace\" class=\"h-[320px] w-full object-cover\" data-kid=\"1-3-2-1-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&w=900&q=82&fit=crop\"/>\n                        <div data-kid=\"1-3-2-1-2-1-2\">\n                            <p class=\"ybw-kicker text-[#a3413a]\" data-kid=\"1-3-2-1-2-1-2-1\">\n                                Fashion and Lifestyle\n                            </p>\n                            <h3 class=\"ybw-serif mt-3 text-3xl leading-tight\" data-kid=\"1-3-2-1-2-1-2-2\">\n                                City’s time team dig in to unearth mansion’s hidden history\n                            </h3>\n                            <p class=\"mt-4 text-sm leading-7 text-stone-600\" data-kid=\"1-3-2-1-2-1-2-3\">\n                                A group of archaeologists has dug deep through aeons of history to uncover evidence of a remarkable Yorkshire story.\n                            </p>\n                            <a class=\"editorial-link mt-7 inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-[.16em] text-[#a3413a]\" data-kid=\"1-3-2-1-2-1-2-4\" href=\"#article\">\n                                Read the story\n                                <span class=\"link-arrow\" data-kid=\"1-3-2-1-2-1-2-4-1\">\n                                    →\n                                </span>\n                            </a>\n                        </div>\n                    </article>\n                    <div class=\"border-t border-stone-900/15\" data-kid=\"1-3-2-1-2-2\">\n                        <a class=\"editorial-link flex items-start justify-between gap-6 border-b border-stone-900/15 py-6\" data-kid=\"1-3-2-1-2-2-1\" href=\"#article-2\">\n                            <span data-kid=\"1-3-2-1-2-2-1-1\">\n                                <span class=\"ybw-kicker text-stone-500\" data-kid=\"1-3-2-1-2-2-1-1-1\">\n                                    Business\n                                </span>\n                                <span class=\"ybw-serif mt-2 block text-2xl leading-tight\" data-kid=\"1-3-2-1-2-2-1-1-2\">\n                                    Yorkshire law firm achieves six years of growth\n                                </span>\n                                <span class=\"mt-2 block text-sm leading-6 text-stone-500\" data-kid=\"1-3-2-1-2-2-1-1-3\">\n                                    A regional business builds a resilient future through people-first decisions.\n                                </span>\n                            </span>\n                            <span class=\"link-arrow text-xl text-[#a3413a]\" data-kid=\"1-3-2-1-2-2-1-2\">\n                                →\n                            </span>\n                        </a>\n                        <a class=\"editorial-link flex items-start justify-between gap-6 border-b border-stone-900/15 py-6\" data-kid=\"1-3-2-1-2-2-2\" href=\"#article-3\">\n                            <span data-kid=\"1-3-2-1-2-2-2-1\">\n                                <span class=\"ybw-kicker text-stone-500\" data-kid=\"1-3-2-1-2-2-2-1-1\">\n                                    Business\n                                </span>\n                                <span class=\"ybw-serif mt-2 block text-2xl leading-tight\" data-kid=\"1-3-2-1-2-2-2-1-2\">\n                                    The Dance Studio named a favourite local business\n                                </span>\n                                <span class=\"mt-2 block text-sm leading-6 text-stone-500\" data-kid=\"1-3-2-1-2-2-2-1-3\">\n                        