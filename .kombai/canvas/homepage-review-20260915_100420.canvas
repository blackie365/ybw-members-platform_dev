data-name=\"footer content wrapper\">\n            <div class=\"grid gap-12 lg:grid-cols-[1.2fr_2fr]\" data-kid=\"1-5-1-1\" data-name=\"footer grid\">\n                <div data-kid=\"1-5-1-1-1\" data-name=\"footer brand block\">\n                    <div class=\"editorial-serif text-3xl\" data-kid=\"1-5-1-1-1-1\" data-name=\"brand name\">\n                        Yorkshire\n                        <span class=\"italic\" data-kid=\"1-5-1-1-1-1-1\" data-name=\"italic brand name word\">\n                            BusinessWoman\n                        </span>\n                    </div>\n                    <p class=\"mt-4 max-w-[280px] text-sm leading-relaxed text-white/55\" data-kid=\"1-5-1-1-1-2\" data-name=\"footer description\">\n                        Independent stories, useful connections and a bigger table for women across Yorkshire.\n                    </p>\n                    <div class=\"mt-7 text-sm text-white/65\" data-kid=\"1-5-1-1-1-3\" data-name=\"footer contact email\">\n                        editor@yorkshirebusinesswoman.co.uk\n                    </div>\n                </div>\n                <div class=\"grid grid-cols-2 gap-8 sm:grid-cols-4\" data-kid=\"1-5-1-1-2\" data-name=\"footer links grid\">\n                    <div data-kid=\"1-5-1-1-2-1\" data-name=\"footer link column\">\n                        <div class=\"mb-4 text-[10px] font-semibold uppercase tracking-[.2em] text-white/45\" data-kid=\"1-5-1-1-2-1-1\" data-name=\"footer link header\">\n                            Magazine\n                        </div>\n                        <div class=\"space-y-3 text-sm text-white/65\" data-kid=\"1-5-1-1-2-1-2\" data-name=\"footer link group\">\n                            <a class=\"block hover:text-white\" data-kid=\"1-5-1-1-2-1-2-1\" data-name=\"link\" href=\"#about\">\n                                About us\n                            </a>\n                            <a class=\"block hover:text-white\" data-kid=\"1-5-1-1-2-1-2-2\" data-name=\"link\" href=\"#edition\">\n                                New edition\n                            </a>\n                            <a class=\"block hover:text-white\" data-kid=\"1-5-1-1-2-1-2-3\" data-name=\"link\" href=\"#members\">\n                                Members\n                            </a>\n                        </div>\n                    </div>\n                    <div data-kid=\"1-5-1-1-2-2\" data-name=\"footer link column\">\n                        <div class=\"mb-4 text-[10px] font-semibold uppercase tracking-[.2em] text-white/45\" data-kid=\"1-5-1-1-2-2-1\" data-name=\"footer link header\">\n                            Explore\n                        </div>\n                        <div class=\"space-y-3 text-sm text-white/65\" data-kid=\"1-5-1-1-2-2-2\" data-name=\"footer link group\">\n                            <a class=\"block hover:text-white\" data-kid=\"1-5-1-1-2-2-2-1\" data-name=\"link\" href=\"#stories\">\n                                News\n                            </a>\n                            <a class=\"block hover:text-white\" data-kid=\"1-5-1-1-2-2-2-2\" data-name=\"link\" href=\"#events\">\n                                Events\n                            </a>\n                            <a class=\"block hover:text-white\" data-kid=\"1-5-1-1-2-2-2-3\" data-name=\"link\" href=\"#topics\">\n                                Topics\n                            </a>\n                        </div>\n                    </div>\n                    <div data-kid=\"1-5-1-1-2-3\" data-name=\"footer link column\">\n                        <div class=\"mb-4 text-[10px] font-semibold uppercase tracking-[.2em] text-white/45\" data-kid=\"1-5-1-1-2-3-1\" data-name=\"footer link header\">\n                            Join\n                        </div>\n                        <div class=\"space-y-3 text-sm text-white/65\" data-kid=\"1-5-1-1-2-3-2\" data-name=\"footer link group\">\n                            <a class=\"block hover:text-white\" data-kid=\"1-5-1-1-2-3-2-1\" data-name=\"link\" href=\"#join\">\n                                Membership\n                            </a>\n                            <a class=\"block hover:text-white\" data-kid=\"1-5-1-1-2-3-2-2\" data-name=\"link\" href=\"#sign-in\">\n                                Sign in\n                            </a>\n                            <a class=\"block hover:text-white\" data-kid=\"1-5-1-1-2-3-2-3\" data-name=\"link\" href=\"#contact\">\n                                Contact\n                            </a>\n                        </div>\n                    </div>\n                    <div data-kid=\"1-5-1-1-2-4\" data-name=\"footer link column\">\n                        <div class=\"mb-4 text-[10px] font-semibold uppercase tracking-[.2em] text-white/45\" data-kid=\"1-5-1-1-2-4-1\" data-name=\"footer link header\">\n                            Legal\n                        </div>\n                        <div class=\"space-y-3 text-sm text-white/65\" data-kid=\"1-5-1-1-2-4-2\" data-name=\"footer link group\">\n                            <a class=\"block hover:text-white\" data-kid=\"1-5-1-1-2-4-2-1\" data-name=\"link\" href=\"#privacy\">\n                                Privacy\n                            </a>\n                            <a class=\"block hover:text-white\" data-kid=\"1-5-1-1-2-4-2-2\" data-name=\"link\" href=\"#terms\">\n                                Terms\n                            </a>\n                            <a class=\"block hover:text-white\" data-kid=\"1-5-1-1-2-4-2-3\" data-name=\"link\" href=\"#cookies\">\n                                Cookies\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-14 flex flex-col justify-between gap-3 border-t border-white/12 pt-6 text-xs text-white/40 sm:flex-row\" data-kid=\"1-5-1-2\" data-name=\"footer copyright block\">\n                <span data-kid=\"1-5-1-2-1\" data-name=\"copyright text\">\n                    © 2026 Yorkshire BusinessWoman\n                </span>\n                <span data-kid=\"1-5-1-2-2\" data-name=\"tagline text\">\n                    Designed for leaders. Built for impact.\n                </span>\n            </div>\n        </div>\n    </footer>\n    <div class=\"fixed bottom-4 left-4 right-4 z-50 mx-auto flex max-w-[720px] items-center justify-between gap-4 border border-[#d8d4cf] bg-white px-4 py-3 text-xs paper-shadow\" data-kid=\"1-6\" data-name=\"cookie consent banner\">\n        <span class=\"text-[#78716c]\" data-kid=\"1-6-1\" data-name=\"cookie banner message\">\n            Cookies help us understand what’s useful.\n            <a class=\"font-semibold text-[#a3413a] underline underline-offset-2\" data-kid=\"1-6-1-1\" data-name=\"cookie policy link\" href=\"#cookies\">\n                Cookie policy\n            </a>\n        </span>\n        <div class=\"flex shrink-0 gap-2\" data-kid=\"1-6-2\" data-name=\"cookie consent action buttons\">\n            <button class=\"px-3 py-2 text-[10px] font-bold uppercase tracking-[.14em] text-[#78716c] hover:text-[#1c1917]\" data-kid=\"1-6-2-1\" data-name=\"decline button\" type=\"button\">\n                Decline\n            </button>\n            <button class=\"bg-[#1c1917] px-3 py-2 text-[10px] font-bold uppercase tracking-[.14em] text-white hover:bg-[#a3413a]\" data-kid=\"1-6-2-2\" data-name=\"accept button\" type=\"button\">\n                Accept\n            </button>\n        </div>\n    </div>\n</div>\n",
