-1\">\n                            <span class=\"ybw-serif text-2xl\" data-kid=\"1-3-5-1-2-6-1-1\">\n                                Leadership\n                            </span>\n                            <span class=\"mt-1 block text-xs text-stone-500\" data-kid=\"1-3-5-1-2-6-1-2\">\n                                104 articles\n                            </span>\n                        </span>\n                        <span class=\"link-arrow text-xl text-[#a3413a]\" data-kid=\"1-3-5-1-2-6-2\">\n                            →\n                        </span>\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[#f0ebe3]\" data-kid=\"1-3-6\">\n            <div class=\"mx-auto max-w-[1280px] px-8 py-16 lg:py-20\" data-kid=\"1-3-6-1\">\n                <div class=\"flex items-end justify-between border-b border-stone-900/20 pb-6\" data-kid=\"1-3-6-1-1\">\n                    <div data-kid=\"1-3-6-1-1-1\">\n                        <p class=\"ybw-kicker text-[#a3413a]\" data-kid=\"1-3-6-1-1-1-1\">\n                            The Yorkshire briefing\n                        </p>\n                        <h2 class=\"ybw-serif mt-2 text-4xl\" data-kid=\"1-3-6-1-1-1-2\">\n                            Economic insights\n                        </h2>\n                    </div>\n                    <span class=\"text-xs text-stone-500\" data-kid=\"1-3-6-1-1-2\">\n                        Market notes · September 2026\n                    </span>\n                </div>\n                <div class=\"grid divide-y divide-stone-900/15 lg:grid-cols-3 lg:divide-x lg:divide-y-0\" data-kid=\"1-3-6-1-2\">\n                    <article class=\"py-8 lg:pr-8\" data-kid=\"1-3-6-1-2-1\">\n                        <p class=\"ybw-kicker text-[#a3413a]\" data-kid=\"1-3-6-1-2-1-1\">\n                            BBC Business\n                        </p>\n                        <h3 class=\"ybw-serif mt-4 text-2xl leading-tight\" data-kid=\"1-3-6-1-2-1-2\">\n                            State pension likely to top £13,000 a year as UK wage growth slows\n                        </h3>\n                        <p class=\"mt-4 text-sm leading-7 text-stone-600\" data-kid=\"1-3-6-1-2-1-3\">\n                            The rise has reignited debate about long-term affordability and generational fairness.\n                        </p>\n                        <a class=\"editorial-link mt-6 inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-[.16em] text-stone-700 hover:text-[#a3413a]\" data-kid=\"1-3-6-1-2-1-4\" href=\"#insight-1\">\n                            Read the briefing\n                            <span class=\"link-arrow\" data-kid=\"1-3-6-1-2-1-4-1\">\n                                →\n                            </span>\n                        </a>\n                    </article>\n                    <article class=\"py-8 lg:px-8\" data-kid=\"1-3-6-1-2-2\">\n                        <p class=\"ybw-kicker text-[#a3413a]\" data-kid=\"1-3-6-1-2-2-1\">\n                            BBC Business\n                        </p>\n                        <h3 class=\"ybw-serif mt-4 text-2xl leading-tight\" data-kid=\"1-3-6-1-2-2-2\">\n                            Trump says AI safety fears a ‘hoax’ as calls grow for greater safeguards\n                        </h3>\n                        <p class=\"mt-4 text-sm leading-7 text-stone-600\" data-kid=\"1-3-6-1-2-2-3\">\n                            The latest debate gives Yorkshire founders another reason to build thoughtful systems now.\n                        </p>\n                        <a class=\"editorial-link mt-6 inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-[.16em] text-stone-700 hover:text-[#a3413a]\" data-kid=\"1-3-6-1-2-2-4\" href=\"#insight-2\">\n                            Read the briefing\n                            <span class=\"link-arrow\" data-kid=\"1-3-6-1-2-2-4-1\">\n                                →\n                            </span>\n                        </a>\n                    </article>\n                    <article class=\"py-8 lg:pl-8\" data-kid=\"1-3-6-1-2-3\">\n                        <p class=\"ybw-kicker text-[#a3413a]\" data-kid=\"1-3-6-1-2-3-1\">\n                            Local lens\n                        </p>\n                        <h3 class=\"ybw-serif mt-4 text-2xl leading-tight\" data-kid=\"1-3-6-1-2-3-2\">\n                            What resilient businesses are watching this month\n                        </h3>\n                        <p class=\"mt-4 text-sm leading-7 text-stone-600\" data-kid=\"1-3-6-1-2-3-3\">\n                            A short, useful edit of the signals shaping decisions across the region.\n                        </p>\n                        <a class=\"editorial-link mt-6 inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-[.16em] text-stone-700 hover:text-[#a3413a]\" data-kid=\"1-3-6-1-2-3-4\" href=\"#insight-3\">\n                            Read the briefing\n                            <span class=\"link-arrow\" data-kid=\"1-3-6-1-2-3-4-1\">\n                                →\n                            </span>\n                        </a>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-b border-stone-900/15 bg-white\" data-kid=\"1-3-7\" id=\"community\">\n            <div class=\"mx-auto grid max-w-[1280px] gap-12 px-8 py-16 lg:grid-cols-[.8fr_1.2fr] lg:items-center lg:py-20\" data-kid=\"1-3-7-1\">\n                <div data-kid=\"1-3-7-1-1\">\n                    <p class=\"ybw-kicker text-[#a3413a]\" data-kid=\"1-3-7-1-1-1\">\n                        Member spotlight\n                    </p>\n                    <h2 class=\"ybw-serif mt-3 text-4xl leading-tight\" data-kid=\"1-3-7-1-1-2\">\n                        A community that moves with you\n                    </h2>\n                    <p class=\"mt-5 max-w-md text-sm leading-7 text-stone-600\" data-kid=\"1-3-7-1-1-3\">\n                        Real stories from the women building a more generous, ambitious business culture across Yorkshire.\n                    </p>\n                    <a class=\"editorial-link mt-8 inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-[.16em] text-[#a3413a]\" data-kid=\"1-3-7-1-1-4\" href=\"#members\">\n                        Meet the members\n                        <span class=\"link-arrow\" data-kid=\"1-3-7-1-1-4-1\">\n                            →\n                        </span>\n                    </a>\n                </div>\n                <div class=\"grid gap-8 border-l-2 border-[#a3413a] pl-8 lg:grid-cols-[1fr_auto] lg:items-center lg:pl-12\" data-kid=\"1-3-7-1-2\">\n                    <blockquote data-kid=\"1-3-7-1-2-1\">\n                        <p class=\"ybw-serif text-3xl italic leading-tight lg:text-4xl\" data-kid=\"1-3-7-1-2-1-1\">\n                            “The support and perspective from this community helped me make bigger decisions with much more confidence.”\n                        </p>\n                        <footer class=\"mt-6 text-sm text-stone-600\" data-kid=\"1-3-7-1-2-1-2\">\n                            <strong class=\"font-semibold text-[#1c1917]\" data-kid=\"1-3-7-1-2-1-2-1\">\n                                Fiona Ibbetson\n                            </strong>\n                            · Member for five years\n                        </footer>\n                    </blockquote>\n                    <img alt=\"Member portrait\" class=\"h-28 w-28 rounded-full object-cover\" data-kid=\"1-3-7-1-2-2\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&w=360&q=82&fit=crop\"/>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[#a3413a] text-white\" data-kid=\"1-3-8\" id=\"newsletter\">\n            <div class=\"mx-auto flex max-w-[1280px] flex-col gap-8 px-8 py-12 lg:flex-row lg:items-center lg:justify-between lg:py-14\" data-kid=\"1-3-8-1\">\n                <div data-kid=\"1-3-8-1-1\">\n                    <p class=\"ybw-kicker text-[#f0c2a0]\" data-kid=\"1-3-8-1-1-1\">\n                        A useful note, every Friday\n                    </p>\n                    <h2 class=\"ybw-serif mt-2 text-4xl\" data-kid=\"1-3-8-1-1-2\">\n                        The Yorkshire BusinessWoman briefing\n                    </h2>\n                    <p class=\"mt-3 max-w-xl text-sm leading-6 text-white/80\" data-kid=\"1-3-8-1-1-3\">\n                        One considered email each week: the stories, events, and ideas worth carrying into your next conversation.\n                    </p>\n                </div>\n                <form class=\"flex w-full max-w-lg flex-col gap-3 sm:flex-row\" data-kid=\"1-3-8-1-2\" onsubmit=\"return false\">\n                    <label class=\"sr-only\" data-kid=\"1-3-8-1-2-1\" for=\"email\">\n                        Email address\n                    </label>\n                    <input class=\"h-12 flex-1 border border-white/40 bg-transparent px-4 text-sm text-white placeholder:text-white/65 outline-none focus:border-white\" data-kid=\"1-3-8-1-2-2\" id=\"email\" placeholder=\"Your email address\" type=\"email\"/>\n                    <button class=\"h-12 bg-white px-6 text-[10px] font-bold uppercase tracking-[.16em] text-[#a3413a] hover:bg-[#f0ebe3]\" data-kid=\"1-3-8-1-2-3\" type=\"submit\">\n                        Subscribe\n                        <span aria-hidden=\"true\" data-kid=\"1-3-8-1-2-3-1\">\n                            →\n                        </span>\n                    </button>\n                </form>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bg-[#1c1917] text-[#fafaf9]\" data-kid=\"1-4\" id=\"about\">\n        <div class=\"mx-auto max-w-[1280px] px-8 py-14 lg:py-16\" data-kid=\"1-4-1\">\n            <div class=\"grid gap-12 lg:grid-cols-[1.4fr_2fr]\" data-kid=\"1-4-1-1\">\n                <div data-kid=\"1-4-1-1-1\">\n                    <a class=\"ybw-serif text-3xl\" data-kid=\"1-4-1-1-1-1\" href=\"#top\">\n                        Yorkshire BusinessWoman\n                    </a>\n                    <p class=\"mt-4 max-w-sm text-sm leading-6 text-stone-400\" data-kid=\"1-4-1-1-1-2\">\n                        A magazine and community for women building meaningful businesses across Yorkshire.\n                    </p>\n                    <p class=\"mt-5 text-sm text-stone-400\" data-kid=\"1-4-1-1-1-3\">\n                        editor@yorkshirebusinesswoman.co.uk\n                    </p>\n                </div>\n                <div class=\"grid grid-cols-2 gap-8 sm:grid-cols-4\" data-kid=\"1-4-1-1-2\">\n                    <div data-kid=\"1-4-1-1-2-1\">\n                        <h3 class=\"ybw-kicker text-stone-500\" data-kid=\"1-4-1-1-2-1-1\">\n                            Magazine\n                        </h3>\n                        <div class=\"mt-4 space-y-3 text-sm text-stone-300\" data-kid=\"1-4-1-1-2-1-2\">\n                            <a class=\"block hover:text-white\" data-kid=\"1-4-1-1-2-1-2-1\" href=\"#stories\">\n                                News\n                            </a>\n                            <a class=\"block hover:text-white\" data-kid=\"1-4-1-1-2-1-2-2\" href=\"#edition\">\n                                New edition\n                            </a>\n                            <a class=\"block hover:text-white\" data-kid=\"1-4-1-1-2-1-2-3\" href=\"#topics\">\n                                Topics\n                            </a>\n                        </div>\n                    </div>\n                    <div data-kid=\"1-4-1-1-2-2\">\n                        <h3 class=\"ybw-kicker text-stone-500\" data-kid=\"1-4-1-1-2-2-1\">\n                            Community\n                        </h3>\n                        <div class=\"mt-4 space-y-3 text-sm text-stone-300\" data-kid=\"1-4-1-1-2-2-2\">\n                            <a class=\"block hover:text-white\" data-kid=\"1-4-1-1-2-2-2-1\" href=\"#community\">\n                                Members\n                            </a>\n                            <a class=\"block hover:text-white\" data-kid=\"1-4-1-1-2-2-2-2\" href=\"#events\">\n                                Events\n                            </a>\n                            <a class=\"block hover:text-white\" data-kid=\"1-4-1-1-2-2-2-3\" href=\"#newsletter\">\n                                Join us\n                            </a>\n                        </div>\n                    </div>\n                    <div data-kid=\"1-4-1-1-2-3\">\n                        <h3 class=\"ybw-kicker text-stone-500\" data-kid=\"1-4-1-1-2-3-1\">\n                            Resources\n                        </h3>\n                        <div class=\"mt-4 space-y-3 text-sm text-stone-300\" data-kid=\"1-4-1-1-2-3-2\">\n                            <a class=\"block hover:text-white\" data-kid=\"1-4-1-1-2-3-2-1\" href=\"#contact\">\n                                Contact\n                            </a>\n                            <a class=\"block hover:text-white\" data-kid=\"1-4-1-1-2-3-2-2\" href=\"#offers\">\n                                Offers\n                            </a>\n                            <a class=\"block hover:text-white\" data-kid=\"1-4-1-1-2-3-2-3\" href=\"#login\">\n                                Login\n                            </a>\n                        </div>\n                    </div>\n                    <div data-kid=\"1-4-1-1-2-4\">\n                        <h3 class=\"ybw-kicker text-stone-500\" data-kid=\"1-4-1-1-2-4-1\">\n                            Legal\n                        </h3>\n                        <div class=\"mt-4 space-y-3 text-sm text-stone-300\" data-kid=\"1-4-1-1-2-4-2\">\n                            <a class=\"block hover:text-white\" data-kid=\"1-4-1-1-2-4-2-1\" href=\"#privacy\">\n                                Privacy\n                            </a>\n                            <a class=\"block hover:text-white\" data-kid=\"1-4-1-1-2-4-2-2\" href=\"#terms\">\n                                Terms\n                            </a>\n                            <a class=\"block hover:text-white\" data-kid=\"1-4-1-1-2-4-2-3\" href=\"#cookies\">\n                                Cookies\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-12 flex flex-col justify-between gap-4 border-t border-white/10 pt-6 text-xs text-stone-500 sm:flex-row\" data-kid=\"1-4-1-2\">\n                <span data-kid=\"1-4-1-2-1\">\n                    © 2026 Yorkshire BusinessWoman\n                </span>\n                <span data-kid=\"1-4-1-2-2\">\n                    Designed for leaders. Built for impact.\n                </span>\n            </div>\n        </div>\n    </footer>\n</div>\n<script>\n    const storyData = [\n    { title: 'Zebra Print Group celebrates 20 years in business', excerpt: 'Leeds-based Zebra Print Group is celebrating 20 years in business, marking two decades since the family-run print company was founded.', image: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&w=1400&q=82&fit=crop' },\n    { title: 'Yorkshire law firm achieves six years of growth', excerpt: 'A regional business builds a resilient future through people-first decisions and a clear point of view.', image: 'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?auto=format&w=1400&q=82&fit=crop' },\n    { title: 'The Dance Studio named a favourite local business', excerpt: 'How one Leeds studio built a community around movement, confidence, and a generous welcome.', image: 'https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&w=1400&q=82&fit=crop' }\n  ];\n  document.querySelectorAll('[data-story]').forEach((button) => {\n    button.addEventListener('click', () => {\n      const story = storyData[Number(button.dataset.story)];\n      document.querySelectorAll('[data-story]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));\n      document.getElementById('hero-title').textContent = story.title;\n      document.getElementById('hero-excerpt').textContent = story.excerpt;\n      document.getElementById('hero-image').src = story.image;\n    });\n  });\n</script>\n",
