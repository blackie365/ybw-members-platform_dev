    "var_929c3295b196": {
      "type": "variant",
      "label": "Homepage Review — Yorkshire Community Desk",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');\n</style>\n<div class=\"min-h-screen bg-[#faf8f3] text-[#1c1410] font-sans\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-b border-[#ded6cc] bg-[#faf8f3]\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"mx-auto flex max-w-[1240px] items-center justify-between gap-8 px-8 py-5\" data-kid=\"1-1-1\" data-name=\"navigation header wrapper\">\n            <a aria-label=\"Yorkshire BusinessWoman home\" class=\"shrink-0\" data-kid=\"1-1-1-1\" data-name=\"home link\" href=\"#top\">\n                <img alt=\"Yorkshire BusinessWoman\" class=\"h-9 w-auto object-contain\" data-kid=\"1-1-1-1-1\" data-name=\"logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/logo-nav-v3.png\"/>\n            </a>\n            <nav aria-label=\"Primary navigation\" class=\"hidden items-center gap-8 text-[11px] font-semibold uppercase tracking-[0.17em] text-[#51483f] lg:flex\" data-kid=\"1-1-1-2\" data-name=\"primary navigation menu\">\n                <a class=\"hover:text-[#a3413a]\" data-kid=\"1-1-1-2-1\" data-name=\"read link\" href=\"#desk\">\n                    Read\n                </a>\n                <a class=\"hover:text-[#a3413a]\" data-kid=\"1-1-1-2-2\" data-name=\"events link\" href=\"#events\">\n                    Events\n                </a>\n                <a class=\"hover:text-[#a3413a]\" data-kid=\"1-1-1-2-3\" data-name=\"topics link\" href=\"#topics\">\n                    Topics\n                </a>\n                <a class=\"hover:text-[#a3413a]\" data-kid=\"1-1-1-2-4\" data-name=\"members link\" href=\"#members\">\n                    Members\n                </a>\n                <a class=\"hover:text-[#a3413a]\" data-kid=\"1-1-1-2-5\" data-name=\"about link\" href=\"#about\">\n                    About\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-5\" data-kid=\"1-1-1-3\" data-name=\"header actions wrapper\">\n                <button class=\"hidden text-[11px] font-semibold uppercase tracking-[0.17em] text-[#51483f] hover:text-[#a3413a] sm:block\" data-kid=\"1-1-1-3-1\" data-name=\"sign in button\" type=\"button\">\n                    Sign in\n                </button>\n                <a class=\"inline-flex items-center bg-[#a3413a] px-5 py-3 text-[10px] font-bold uppercase tracking-[0.18em] text-white hover:bg-[#87352f]\" data-kid=\"1-1-1-3-2\" data-name=\"join community button\" href=\"#join\">\n                    Join the community\n                </a>\n            </div>\n        </div>\n        <div class=\"border-t border-[#ded6cc] bg-[#201b18] px-8 py-2.5 text-center text-[10px] font-semibold uppercase tracking-[0.16em] text-[#f4eee6]\" data-kid=\"1-1-2\" data-name=\"header news ticker\">\n            <span class=\"mr-3 text-[#d27d6f]\" data-kid=\"1-1-2-1\" data-name=\"ticker label\">\n                Today in Yorkshire\n            </span>\n            <span data-kid=\"1-1-2-2\" data-name=\"first news headline\">\n                Independent school celebrates a major milestone\n            </span>\n            <span class=\"mx-5 text-[#a3413a]\" data-kid=\"1-1-2-3\" data-name=\"ticker separator\">\n                /\n            </span>\n            <span data-kid=\"1-1-2-4\" data-name=\"second news headline\">\n                New voices shaping the region’s next chapter\n            </span>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content area\" id=\"top\">\n        <section class=\"mx-auto grid max-w-[1240px] gap-10 px-8 pb-16 pt-12 lg:grid-cols-[1.35fr_0.65fr] lg:items-stretch lg:pt-14\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"relative min-h-[520px] overflow-hidden bg-[#201b18]\" data-kid=\"1-2-1-1\" data-name=\"hero image background container\">\n                <img alt=\"Businesswoman smiling in a bright Yorkshire workplace\" class=\"absolute inset-0 h-full w-full object-cover opacity-80\" data-kid=\"1-2-1-1-1\" data-name=\"hero cover image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&w=1400&q=80&fit=crop\"/>\n                <div class=\"absolute inset-0 bg-gradient-to-r from-black/75 via-black/25 to-transparent\" data-kid=\"1-2-1-1-2\" data-name=\"hero image gradient overlay\">\n                </div>\n                <div class=\"relative flex min-h-[520px] max-w-2xl flex-col justify-end p-9 text-white lg:p-12\" data-kid=\"1-2-1-1-3\" data-name=\"hero content container\">\n                    <div class=\"mb-auto flex items-center justify-between gap-4 pt-1 text-[10px] font-semibold uppercase tracking-[0.22em] text-white/70\" data-kid=\"1-2-1-1-3-1\" data-name=\"hero metadata wrapper\">\n                        <span class=\"text-[#e5a397]\" data-kid=\"1-2-1-1-3-1-1\" data-name=\"hero category text\">\n                            Yorkshire / Business\n                        </span>\n                        <span data-kid=\"1-2-1-1-3-1-2\" data-name=\"hero tag text\">\n                            Featured story\n                        </span>\n                    </div>\n                    <div data-kid=\"1-2-1-1-3-2\" data-name=\"hero headline content block\">\n                        <p class=\"mb-4 max-w-md text-sm font-medium leading-relaxed text-white/80\" data-kid=\"1-2-1-1-3-2-1\" data-name=\"hero description text\">\n                            A family-run print company looks back on two decades of people, craft, and steady growth in Leeds.\n                        </p>\n                        <h1 class=\"max-w-2xl font-serif text-5xl font-medium leading-[1.02] tracking-[-0.025em] sm:text-6xl\" data-kid=\"1-2-1-1-3-2-2\" data-name=\"hero headline\">\n                            Zebra Print Group celebrates 20 years in business\n                        </h1>\n                        <div class=\"mt-8 flex flex-wrap items-center gap-4\" data-kid=\"1-2-1-1-3-2-3\" data-name=\"hero actions wrapper\">\n                            <a class=\"inline-flex items-center gap-3 bg-white px-6 py-3.5 text-[10px] font-bold uppercase tracking-[0.18em] text-[#201b18] hover:bg-[#f0e8df]\" data-kid=\"1-2-1-1-3-2-3-1\" data-name=\"read story button\" href=\"#story\">\n                                Read the story\n                                <span class=\"text-lg leading-none\" data-kid=\"1-2-1-1-3-2-3-1-1\" data-name=\"read story arrow icon\">\n                                    →\n                                </span>\n                            </a>\n                            <span class=\"text-xs text-white/65\" data-kid=\"1-2-1-1-3-2-3-2\" data-name=\"hero story metadata\">\n                                6 min read · Leeds\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <aside aria-label=\"More from the desk\" class=\"flex flex-col border border-[#ded6cc] bg-[#f4eee6] p-7 lg:p-8\" data-kid=\"1-2-1-2\" data-name=\"more from the desk sidebar\">\n                <div class=\"flex items-center justify-between border-b border-[#d5ccc1] pb-4\" data-kid=\"1-2-1-2-1\" data-name=\"sidebar header\">\n                    <span class=\"text-[10px] font-bold uppercase tracking-[0.24em] text-[#a3413a]\" data-kid=\"1-2-1-2-1-1\" data-name=\"sidebar title\">\n                        More from the desk\n                    </span>\n                    <span class=\"text-xs text-[#776e66]\" data-kid=\"1-2-1-2-1-2\" data-name=\"sidebar subtitle\">\n                        This week\n                    </span>\n                </div>\n                <div class=\"divide-y divide-[#d5ccc1]\" data-kid=\"1-2-1-2-2\" data-name=\"sidebar articles list\">\n                    <a class=\"group block py-6\" data-kid=\"1-2-1-2-2-1\" data-name=\"first article link\" href=\"#story-two\">\n                        <p class=\"mb-2 text-[10px] font-bold uppercase tracking-[0.18em] text-[#a3413a]\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"article category\">\n                            People & place\n                        </p>\n                        <h2 class=\"font-serif text-2xl leading-tight text-[#1c1410] group-hover:text-[#a3413a]\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"article title\">\n                            The independent school making room for 1,400 years of history\n                        </h2>\n                        <p class=\"mt-3 text-sm leading-relaxed text-[#776e66]\" data-kid=\"1-2-1-2-2-1-3\" data-name=\"article summary\">\n                            A new chapter for a familiar York landmark.\n                        </p>\n                    </a>\n                    <a class=\"group block py-6\" data-kid=\"1-2-1-2-2-2\" data-name=\"second article link\" href=\"#story-three\">\n                        <p class=\"mb-2 text-[10px] font-bold uppercase tracking-[0.18em] text-[#a3413a]\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"article category\">\n                            Community\n                        </p>\n                        <h2 class=\"font-serif text-2xl leading-tight text-[#1c1410] group-hover:text-[#a3413a]\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"article title\">\n                            The dance studio named among the nation’s favourites\n                        </h2>\n                        <p class=\"mt-3 text-sm leading-relaxed text-[#776e66]\" data-kid=\"1-2-1-2-2-2-3\" data-name=\"article summary\">\n                            What happens when a local class becomes a shared ritual.\n                        </p>\n                    </a>\n                    <a class=\"group block py-6\" data-kid=\"1-2-1-2-2-3\" data-name=\"third article link\" href=\"#story-four\">\n                        <p class=\"mb-2 text-[10px] font-bold uppercase tracking-[0.18em] text-[#a3413a]\" data-kid=\"1-2-1-2-2-3-1\" data-name=\"article category\">\n                            Leadership\n                        </p>\n                        <h2 class=\"font-serif text-2xl leading-tight text-[#1c1410] group-hover:text-[#a3413a]\" data-kid=\"1-2-1-2-2-3-2\" data-name=\"article title\">\n                            Six years of growth, built one client relationship at a time\n                        </h2>\n                        <p class=\"mt-3 text-sm leading-relaxed text-[#776e66]\" data-kid=\"1-2-1-2-2-3-3\" data-name=\"article summary\">\n                            A closer look at a Yorkshire law firm’s next move.\n                        </p>\n                    </a>\n                </div>\n                <div class=\"mt-auto flex items-center justify-between border-t border-[#d5ccc1] pt-5 text-xs text-[#776e66]\" data-kid=\"1-2-1-2-3\" data-name=\"sidebar footer link\">\n                    <span data-kid=\"1-2-1-2-3-1\" data-name=\"sidebar footer text\">\n                        Stories with a local point of view\n                    </span>\n                    <span aria-hidden=\"true\" data-kid=\"1-2-1-2-3-2\" data-name=\"sidebar footer icon\">\n                        ↗\n                    </span>\n                </div>\n            </aside>\n        </section>\n        <section class=\"border-y border-[#ded6cc] bg-white\" data-kid=\"1-2-2\" data-name=\"magazine desk section\" id=\"desk\">\n            <div class=\"mx-auto max-w-[1240px] px-8 py-16 lg:py-20\" data-kid=\"1-2-2-1\" data-name=\"magazine desk content container\">\n                <div class=\"mb-10 flex items-end justify-between gap-8\" data-kid=\"1-2-2-1-1\" data-name=\"section header wrapper\">\n                    <div data-kid=\"1-2-2-1-1-1\" data-name=\"section title group\">\n                        <p class=\"mb-3 text-[10px] font-bold uppercase tracking-[0.24em] text-[#a3413a]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"section label\">\n                            The magazine desk\n                        </p>\n                        <h2 class=\"font-serif text-4xl leading-tight tracking-[-0.02em]\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"section headline\">\n                            A closer look at the people moving Yorkshire forward\n                        </h2>\n                    </div>\n                    <p class=\"hidden max-w-xs text-sm leading-relaxed text-[#776e66] md:block\" data-kid=\"1-2-2-1-1-2\" data-name=\"section description text\">\n                        Reporting, ideas, and useful introductions for women building something meaningful here.\n                    </p>\n                </div>\n                <div class=\"grid gap-12 lg:grid-cols-[1.25fr_0.75fr]\" data-kid=\"1-2-2-1-2\" data-name=\"magazine desk article grid\">\n                    <article class=\"grid gap-7 border-t-2 border-[#201b18] pt-6 sm:grid-cols-[1.15fr_0.85fr]\" data-kid=\"1-2-2-1-2-1\" data-name=\"featured article component\" id=\"story\">\n                        <div class=\"overflow-hidden bg-[#eee7df]\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"featured article image container\">\n                            <img alt=\"Bright independent office interior\" class=\"h-full min-h-[360px] w-full object-cover\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"featured article image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&w=1000&q=80&fit=crop\"/>\n                        </div>\n                        <div class=\"flex flex-col justify-between\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"featured article text content\">\n                            <div data-kid=\"1-2-2-1-2-1-2-1\" data-name=\"featured article category block\">\n                                <p class=\"text-[10px] font-bold uppercase tracking-[0.18em] text-[#a3413a]\" data-kid=\"1-2-2-1-2-1-2-1-1\" data-name=\"featured article category\">\n                                    Working life\n                                </p>\n                                <h3 class=\"mt-4 font-serif text-3xl leading-[1.08]\" data-kid=\"1-2-2-1-2-1-2-1-2\" data-name=\"featured article headline\">\n                                    What makes a workplace feel like it belongs to the people inside it?\n                                </h3>\n                                <p class=\"mt-5 text-[15px] leading-7 text-[#6f675f]\" data-kid=\"1-2-2-1-2-1-2-1-3\" data-name=\"featured article summary\">\n                                    From the first welcome to the last cup of tea, Yorkshire’s best workplaces are designing for belonging as deliberately as they design for growth.\n                                </p>\n                            </div>\n                            <a class=\"mt-8 inline-flex w-fit items-center gap-3 border-b border-[#a3413a] pb-2 text-[10px] font-bold uppercase tracking-[0.18em] text-[#a3413a]\" data-kid=\"1-2-2-1-2-1-2-2\" data-name=\"read feature link\" href=\"#story\">\n                                Read the feature\n                                <span class=\"text-base\" data-kid=\"1-2-2-1-2-1-2-2-1\" data-name=\"read feature arrow\">\n                                    →\n                                </span>\n                            </a>\n                        </div>\n                    </article>\n                    <div class=\"divide-y divide-[#ded6cc] border-t border-[#ded6cc]\" data-kid=\"1-2-2-1-2-2\" data-name=\"article list\">\n                        <a class=\"grid grid-cols-[112px_1fr] gap-5 py-5 group\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"article link\" href=\"#story-two\">\n                            <img alt=\"People gathering around a table\" class=\"h-24 w-28 object-cover\" data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"article image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1504274066651-8d31a536b11a?auto=format&w=300&q=8