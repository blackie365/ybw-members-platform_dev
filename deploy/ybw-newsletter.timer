# Wednesday morning, local VPS sender is authoritative (guaranteed even if
# GitHub Actions drops the schedule event). The GitHub cron fires at 11:11 UTC
# as a cross-region backup — both go through the same atomic dedup in
# /api/cron/daily-newsletter, so exactly one broadcast happens per week.
[Unit]
Description=YBW weekly newsletter timer (Wed 11:05 UTC)

[Timer]
OnCalendar=Wed *-*-* 11:05:00 UTC
Persistent=true
Unit=ybw-newsletter.service

[Install]
WantedBy=timers.target