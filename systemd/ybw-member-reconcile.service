[Unit]
Description=Nightly Ghost <-> PG member count reconcile service
Wants=ybw-member-reconcile.timer
After=network.target ybw-frontend.service postgresql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/ybw-frontend
Environment=NODE_ENV=production
Environment=NODE_PATH=/srv/ybw-frontend/node_modules
Environment=YBWC_ROOT=/srv/ybw-frontend
ExecStart=/srv/ybw-frontend/node_modules/.bin/node /srv/ybw-frontend/scripts/nightly-reconcile.mjs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ybw-member-reconcile
Restart=no
# Hardening
NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/srv/ybw-frontend /tmp /var/tmp
ProtectHome=tmpfs
